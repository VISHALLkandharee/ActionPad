generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model notes {
  id           Int      @id @default(autoincrement())
  raw_text     String
  title        String
  summary      String
  action_items Json     @default("[]")
  created_at   DateTime @default(now()) @db.Timestamptz(6)
}
